# Rahasia & Environment Variables (JANGAN DI-COMMIT!)
.env
.env.*
!.env.example

# Data Sesi Runtime (HANYA folder data/ di root repo — jangan pola "data/"
# tanpa garis miring depan, karena itu ikut mengabaikan site/data/landing.yaml
# dan site/themes/*/data/ sehingga build situs gagal di Vercel)
/data/

# Python Bytecode & Virtual Environment
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Testing & Tooling Cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
.DS_Store

# Situs dokumentasi (Hugo) — hasil build tidak di-commit
site/public/
site/resources/
site/.hugo_build.lock
site/hugo_stats.json
