# ==============================================================================
# KONFIGURASI BOT DISCORD GEMINI AI (WISPBYTE / LOKAL)
# Salin file ini menjadi `.env` lalu isi dengan token & API key milikmu.
# ==============================================================================

# 1. Token Bot dari Discord Developer Portal (Wajib)
DISCORD_BOT_TOKEN=masukkan_token_bot_discord_anda

# 2. API Key dari Google AI Studio - https://aistudio.google.com/apikey (Wajib)
#    Tips: Bisa isi 1 key saja, atau beberapa key dipisahkan koma (key1,key2) untuk rotasi otomatis!
GEMINI_API_KEY=masukkan_gemini_api_key_anda

# ==============================================================================
# PENGATURAN OPSIONAL (Sudah dioptimalkan cepat untuk Free Tier!)
# ==============================================================================

# ID Server Discord (Opsional: isi jika ingin Slash Command langsung muncul instan <1 detik di 1 server tes.
# Kosongkan jika bot sudah dipakai di banyak server sekaligus)
DISCORD_GUILD_ID=

# Model Google Gemini (Default sudah dioptimalkan super cepat & bebas error 503 di Free Tier)
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_MODEL=gemini-3.6-flash
GEMINI_SEARCH_MODEL=gemini-2.5-flash

# Fitur Google Search Grounding (berita/info hari ini) & Pembaca Link YouTube/Web Otomatis
ENABLE_GOOGLE_SEARCH=true
ENABLE_URL_READER=true

# Pengaturan Generate Gambar:
# - Biarkan GEMINI_PAID_IMAGE_ENABLED=false jika memakai Gemini Free Tier (langsung pakai Flux gratis & cepat)
# - Ubah ke true jika akun AI Studio sudah Paid/Billing dan ingin memakai Nano Banana / Nano Banana Pro (gemini-3-pro-image)
GEMINI_PAID_IMAGE_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
ENABLE_IMAGE_FALLBACK=true

# Batas riwayat pesan & ruang privat aktif
MAX_HISTORY_MESSAGES=30
MAX_THREADS_PER_USER=3

# Zona waktu untuk kesadaran jam real-time AI Agent (Asia/Jakarta, Asia/Makassar, Asia/Jayapura)
BOT_TIMEZONE=Asia/Jakarta

# Durasi default (menit) sebelum AI Agent otomatis memecah kesunyian di channel Auto-Chat (0 = nonaktif)
AGENT_DEFAULT_IDLE_MINUTES=30

# Otomatis bersihkan data sesi privat yang sudah menganggur lebih dari N hari (0 = jangan pernah hapus otomatis)
SESSION_EXPIRE_DAYS=7
