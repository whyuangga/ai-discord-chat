# ==============================================================================
# KONFIGURASI BOT DISCORD GEMINI AI (WISPBYTE / LOKAL)
# Salin file ini menjadi `.env` lalu isi dengan token & API key milikmu.
# ==============================================================================

# 1. Token Bot dari Discord Developer Portal (Wajib)
DISCORD_BOT_TOKEN=masukkan_token_bot_discord_anda

# 2. API Key dari Google AI Studio - https://aistudio.google.com/apikey (Wajib)
#    Tips: Bisa isi 1 key saja, atau beberapa key dipisahkan koma (key1,key2) untuk rotasi otomatis!
GEMINI_API_KEY=masukkan_gemini_api_key_anda

# ==============================================================================
# PENGATURAN OPSIONAL (Sudah dioptimalkan cepat untuk Free Tier!)
# ==============================================================================

# ID Server Discord (Opsional: isi jika ingin Slash Command langsung muncul instan <1 detik di 1 server tes.
# Kosongkan jika bot sudah dipakai di banyak server sekaligus)
DISCORD_GUILD_ID=

# Model Google Gemini (Default sudah dioptimalkan super cepat & bebas error 503 di Free Tier)
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_MODEL=gemini-3.6-flash
GEMINI_SEARCH_MODEL=gemini-2.5-flash

# Fitur Pencarian Berita/Web Live (/cari) & Pembaca Link YouTube/Web
# (Juga bisa di-ON/OFF langsung dari Discord lewat /agent cari & /agent youtube!)
ENABLE_GOOGLE_SEARCH=true
ENABLE_URL_READER=true
# Biarkan false di Free Tier (otomatis memakai mesin pencari web & berita gratis mandiri tanpa error kuota).
# Ubah ke true hanya jika akun Google AI Studio sudah mengaktifkan Billing/Paid Plan.
GEMINI_PAID_SEARCH_ENABLED=false

# Pengaturan Generate Gambar:
# - Biarkan GEMINI_PAID_IMAGE_ENABLED=false jika memakai Gemini Free Tier (langsung pakai Flux gratis & cepat)
# - Ubah ke true jika akun AI Studio sudah Paid/Billing dan ingin memakai Nano Banana / Nano Banana Pro (gemini-3-pro-image)
GEMINI_PAID_IMAGE_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
ENABLE_IMAGE_FALLBACK=true

# Batas riwayat pesan & ruang privat aktif
MAX_HISTORY_MESSAGES=30
MAX_THREADS_PER_USER=3

# Zona waktu untuk kesadaran jam real-time AI Agent (Asia/Jakarta, Asia/Makassar, Asia/Jayapura)
BOT_TIMEZONE=Asia/Jakarta

# Durasi default (menit) sebelum AI Agent otomatis memecah kesunyian di channel Auto-Chat (0 = nonaktif)
AGENT_DEFAULT_IDLE_MINUTES=30

# Otomatis bersihkan data sesi privat yang sudah menganggur lebih dari N hari (0 = jangan pernah hapus otomatis)
SESSION_EXPIRE_DAYS=7

# Proteksi kuota Free Tier: jeda per-member (detik) antar pemakaian command berat seperti /cari, /ringkas link & /ringkas chat (0 = nonaktif)
USER_COMMAND_COOLDOWN_SEC=10

# ==============================================================================
# FITUR SERVER (SERVER STATS, AUTO ROLE, FAKTA HARIAN, & ANTI-PHISHING)
# ==============================================================================
# Penjaga anti-phishing lokal (tanpa API berbayar). Tetap perlu diaktifkan per server
# lewat /keamanan phising aktif:True di Discord.
ENABLE_PHISHING_GUARD=true

# Interval pembaruan Voice Channel statistik server (detik). Minimum 600 agar aman
# dari batas Discord (2 rename / 10 menit per channel).
SERVERSTATS_UPDATE_SEC=600

# Jadwal default rubrik "Fakta Unik Dunia": 4 slot sehari (pagi, siang, sore, malam).
# Bisa diubah kapan saja per server via Discord: /fakta atur channel:#umum jadwal:08:00,20:00
FACTS_DEFAULT_TIMES=08:00,12:00,16:00,20:00

# Maksimal jumlah slot jadwal fakta per hari yang boleh dipasang Admin (1-8)
FACTS_MAX_SLOTS=6

# Jumlah maksimal role yang bisa diberikan otomatis ke member baru (/autorole)
AUTOROLE_MAX_ROLES=3

# ==============================================================================
# FITUR KOMUNITAS RINGAN (GRATIS - TANPA KUOTA GEMINI)
# ==============================================================================
# Semua fitur di bawah ini default NONAKTIF dan hanya aktif setelah Admin menyalakannya
# lewat Discord (/panel-role, /starboard, /verifikasi, /sticky, /perawatan).

# Emoji & ambang default starboard (bisa diubah per server via /starboard atur)
STARBOARD_EMOJI=⭐
STARBOARD_DEFAULT_THRESHOLD=3

# Maksimal pengingat aktif per member (/ingatkan)
REMINDER_MAX_PER_USER=15

# Jeda minimum (detik) sebelum sticky message turun ulang agar channel tidak dibanjiri bot
STICKY_MIN_INTERVAL_SEC=5

# Backup konfigurasi otomatis tiap N hari ke channel /perawatan atur (0 = nonaktif)
BACKUP_INTERVAL_DAYS=7

# ID channel global untuk laporan error bot (opsional; bisa juga diatur per server
# lewat /perawatan atur log_channel:#bot-log). Kosongkan bila tidak dipakai.
BOT_LOG_CHANNEL_ID=

# ==============================================================================
# STREAMING MUSIK (/musik) - LAVALINK v4 + WAVELINK
# ==============================================================================
# Wispbyte TIDAK menyediakan FFmpeg/yt-dlp, jadi audio diproses node Lavalink v4
# (bukan CPU bot). Kosongkan kedua variabel di bawah bila belum ingin memakai musik;
# bot tetap jalan normal dan /musik hanya menampilkan panduan setup.
#
# Isi dengan node Lavalink milik sendiri atau node publik gratis. Format URI fleksibel:
#   LAVALINK_URI=lavalink.example.com:2333
#   LAVALINK_URI=https://lavalink.example.com:443     (otomatis jadi wss://)
#
# ⚠️ ATURAN PORT/TLS (penyebab tersering node gagal tersambung):
#   • Port 443      → WAJIB awalan wss:// atau https://   (contoh: wss://lavalink.jirayu.net:443)
#   • Port non-443  → TANPA awalan                        (contoh: lavalink.jirayu.net:13592)
#   Menulis "host:443" tanpa wss:// akan dicoba sebagai ws:// dan handshake-nya gagal.
#
# 🔎 CEK STATUS setelah restart:
#   /musik status              → kondisi node nyata + ringkasan server
#   /musik node                → diagnosa teknis per node (Admin)
#   /musik node sambung:True   → paksa sambung ulang tanpa restart bot (Admin)
#
# 🧪 TES NODE LANGSUNG DARI CONSOLE WISPBYTE:
#   curl -s -m 15 -H "Authorization: PASSWORD-NODE" https://HOST:443/v4/info
#   → JSON berisi "version"  = node hidup & password benar
#   → 401/403                = password salah
#   → timeout / resolve fail = node mati atau koneksi keluar hosting diblokir
LAVALINK_URI=
LAVALINK_PASSWORD=

# Nama node (bebas, hanya untuk log)
LAVALINK_NODE_NAME=utama

# Bot otomatis menyambung ulang node yang terputus (maks. sekali per 60 detik,
# menumpang watcher yang sudah ada — tanpa proses/loop baru).

# Volume default saat bot bergabung ke voice channel (1-150)
MUSIC_DEFAULT_VOLUME=60

# Batas jumlah lagu di antrean agar RAM bot tetap kecil
MUSIC_MAX_QUEUE=50

# Catatan Rythm Mode (tidak perlu variabel tambahan):
# - Panel pemutar (progress bar + 9 tombol) muncul otomatis & diperbarui tiap 10 detik.
# - Filter audio (/musik filter) & autoplay (/musik autoplay) disimpan per server
#   di data/music_settings.json dan dipulihkan saat bot join voice lagi.

# Keluar otomatis dari voice channel setelah sekian detik tanpa lagu/aktivitas
MUSIC_IDLE_DISCONNECT_SEC=300

# ==============================================================================
# FITUR KERAMAIAN SERVER (Giveaway, Ulang Tahun, Auto-Responder, Pengumuman)
# ==============================================================================
# Semua fitur di bawah ini GRATIS (0 kuota Gemini) & default NONAKTIF sampai Admin
# menyalakannya lewat Discord (/giveaway, /ultah atur, /jawab-otomatis, /pengumuman).
# Data disimpan lokal di data/engagement.json (tanpa database eksternal).

# Batas aturan balasan otomatis per channel
AUTO_REPLY_MAX_RULES=25

# Jeda aman (detik) antar-balasan otomatis supaya channel tidak dibanjiri bot
AUTO_REPLY_COOLDOWN_SEC=20

# Batas pengumuman terjadwal per server
ANNOUNCEMENT_MAX_PER_GUILD=15

# Jumlah giveaway yang sudah selesai & tetap disimpan untuk riwayat pemenang
GIVEAWAY_HISTORY_MAX=25

# ==============================================================================
# ANTI-SPAM & ANTI-RAID RINGAN (Tier 2B)
# ==============================================================================
# Default NONAKTIF sampai Admin menjalankan /keamanan spam di Discord.
# Mode awalnya "lapor" (hanya mencatat ke channel log, TIDAK menghapus pesan).
# Admin, pengurus (Manage Messages), bot, & role pengecualian selalu diabaikan.

# Jumlah pesan dalam satu jendela waktu sebelum dianggap banjir (flood)
SPAM_FLOOD_COUNT=6

# Jendela waktu (detik) untuk menghitung flood
SPAM_FLOOD_WINDOW_SEC=10

# Batas mention dalam SATU pesan sebelum dianggap mention massal
SPAM_MENTION_LIMIT=6

# Batas jumlah link dalam SATU pesan sebelum dianggap link beruntun
SPAM_LINK_LIMIT=4

# Panjang minimum pesan sebelum HURUF KAPITAL diperiksa (fitur ini default NONAKTIF)
SPAM_CAPS_MIN_LENGTH=20

# Durasi time-out saat Admin memilih mode "timeout" (detik, maks 86400)
SPAM_TIMEOUT_SEC=300

# Deteksi raid: jumlah join dalam jendela waktu sebelum Admin diberi peringatan
SPAM_RAID_JOIN_COUNT=8
SPAM_RAID_WINDOW_SEC=60

# ==============================================================================
# LEVELING & XP + TIKET DUKUNGAN (Tier 2C)
# ==============================================================================
# Keduanya default NONAKTIF. Nyalakan dari Discord:
#   /level atur aktif:True        dan        /tiket panel channel:#bantuan

# XP acak per pesan (min & max)
LEVELS_XP_MIN=15
LEVELS_XP_MAX=25

# Jeda minimum antar XP untuk member yang sama (0 = tanpa jeda, rawan farming)
LEVELS_COOLDOWN_SEC=60

# Batas atas level & jumlah member teratas yang disimpan per server
LEVELS_MAX_LEVEL=100
LEVELS_MAX_MEMBERS=500

# Batas tiket aktif per member & panjang transkrip yang disimpan
TICKET_MAX_OPEN_PER_USER=2
TICKET_MAX_TRANSCRIPT_LINES=400

# Tutup otomatis tiket yang menggantung setelah N jam (0 = nonaktif)
TICKET_AUTO_CLOSE_HOURS=0

# ==============================================================================
# TIER 3 — HEMAT KUOTA AI (`/pemakaian`, `/ringkas channel`, `/faq`)
# ==============================================================================
# Batas operasi AI per member per hari (0 = TANPA BATAS alias nonaktif).
# Hanya operasi yang benar-benar memanggil Gemini yang dihitung; `/faq tanya`
# dan cache `/ringkas channel` (0 kuota) tidak mengurangi jatah.
AI_DAILY_CAP_PER_USER=0

# Berapa hari catatan pemakaian disimpan di data/ai_usage.json (auto-dipangkas).
AI_USAGE_KEEP_DAYS=7

# Umur cache hasil /ringkas channel (detik). 1800 = 30 menit.
# Selama cache masih segar, rekap channel & periode yang sama = 0 kuota.
# Isi 0 untuk mematikan cache (setiap rekap memakai 1 panggilan AI).
REKAP_CACHE_TTL_SEC=1800

# Maksimal pesan yang dianalisis saat membuat rekap berperiode (hemat token).
REKAP_MAX_MESSAGES=400
